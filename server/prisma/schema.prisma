generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LogStatus {
  UNLOCKED
  LOCKED
}

enum LogDayType {
  NORMAL
  SHUTDOWN
  MISSED_SHUTDOWN
}

model DailyLog {
  id          String    @id @default(uuid()) @unique()
  createdAt   DateTime  @map("created_at")
  status      LogStatus @default(UNLOCKED)
  lockedAt    DateTime? @map("locked_at")
  dayType     LogDayType @default(NORMAL)
  
  payload     Json      @map("metrics")

  unitId      String
  unit        Unit         @relation(fields: [unitId], references: [id])

  sessionDataId String?
  sessionData   SessionData? @relation(fields: [sessionDataId], references: [id], onDelete: SetNull)
  
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id])

  createdById    String?
  createdByEmail String?
  createdByName  String?
  updatedById    String?
  updatedByEmail String?
  updatedByName  String?

  createdBy      User? @relation("LogCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy      User? @relation("LogUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([unitId, createdAt])
  @@map("daily_logs")
}

model SessionData {
  id              String   @id @default(uuid())
  unitId          String
  unit            Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  orgId           String
  org             Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  sessionStartDate String?
  sessionStartTime String?
  sessionOffDate   String?
  sessionOffTime   String?
  dayStartTime     String?

  isLocked         Boolean  @default(false)
  lockedAt         DateTime? @map("locked_at")

  createdById      String?
  createdByEmail   String?
  createdByName    String?
  updatedById      String?
  updatedByEmail   String?
  updatedByName    String?

  createdBy        User? @relation("SessionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy        User? @relation("SessionUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  logs             DailyLog[]

  @@index([unitId, isLocked])
  @@map("session_data")
}

enum Role {
  SUPER_ADMIN
  ORG_ADMIN
  ORG_STAFF
  UNIT_OPERATOR
}

model Organization {
  id     String             @id @default(uuid())
  name   String
  status String             @default("INACTIVE")
  units  Unit[]
  users User[]
  logs  DailyLog[]
  sessions SessionData[]
}

model Unit {
  id    String             @id @default(uuid())
  name  String
  orgId String
  org   Organization       @relation(fields: [orgId], references: [id])
  users User[]
  logs  DailyLog[]
  sessions SessionData[]

  seasonStartDate String?
  seasonStartTime String?
  seasonEndDate   String?
  seasonEndTime   String?

  @@unique([name, orgId])
}

model User {
  id       String        @id @default(uuid())
  name     String?
  email    String        @unique
  password String?
  status   String        @default("INACTIVE")
  role     Role
  orgId    String?
  org      Organization? @relation(fields: [orgId], references: [id])
  unitId   String?
  unit     Unit?         @relation(fields: [unitId], references: [id])

  createdLogs DailyLog[] @relation("LogCreator")
  updatedLogs DailyLog[] @relation("LogUpdater")
  createdSessions SessionData[] @relation("SessionCreator")
  updatedSessions SessionData[] @relation("SessionUpdater")
}

model InviteToken {
  id          String   @id @default(uuid())
  tokenString String   @unique
  email       String
  role        Role
  orgId       String
  unitId      String?
  expiresAt   DateTime
  isUsed      Boolean  @default(false)
}